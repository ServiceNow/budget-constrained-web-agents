# Copy this file to `.env` and fill in your own values.

# ---------------------------------------------------------------------------
# LLM providers
# Configure whichever provider(s) you use. Model names passed to the code are
# prefixed by provider, e.g. `openrouter/openai/gpt-4o`, `azure/gpt-4o`,
# `anthropic/claude-sonnet-4-5`, `vllm/<model>` or `vllm:8000/<model>`.
# ---------------------------------------------------------------------------

# OpenRouter
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Azure OpenAI / Azure-hosted Anthropic
AZURE_OPENAI_ENDPOINT="https://your-azure-openai-endpoint"
AZURE_ANTHROPIC_ENDPOINT="https://your-azure-anthropic-endpoint"
AZURE_API_KEY="your-azure-api-key"
AZURE_API_VERSION="2024-02-15-preview"

# Anthropic (direct)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Local vLLM server (only needed when using `vllm/...` model names)
VLLM_API_KEY="EMPTY"

# ---------------------------------------------------------------------------
# WebArena website URLs
# Point these at your self-hosted WebArena sites. Use "todo" to skip tasks
# that require a site you are not hosting.
# ---------------------------------------------------------------------------
WA_SHOPPING="todo"
WA_SHOPPING_ADMIN="todo"
WA_REDDIT="todo"
WA_GITLAB="todo"
WA_WIKIPEDIA="todo"
WA_MAP="todo"
WA_HOMEPAGE="todo"
